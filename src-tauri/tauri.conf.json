{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OA Mod Launcher",
  "identifier": "com.shironex.oamod.launcher",
  "build": {
    "devUrl": "http://localhost:15190",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OA Mod Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#f1f8ec"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' http://localhost:15190; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:15190 ws://localhost:15190; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Shironex",
    "category": "Utility",
    "shortDescription": "OA Mod Launcher",
    "longDescription": "Installs OA Mod for Golf With Your Friends, keeps it up to date and removes it again.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMUUyREU5OTk2MkU1MzMKUldRejVXS1o2UzBlb2xrLzhCQjMyZUlSNHhjV1hoMVN3YVppczFHV251Tjkvd2tncW55cHJERDAK",
      "endpoints": [
        "https://github.com/Shironex/oa-mod-launcher/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
